app_js = r'''(() => {
  "use strict";

  const canvas = document.getElementById("artboard");
  const ctx = canvas.getContext("2d");
  const wrap = document.getElementById("artboardWrap");
  const viewport = document.getElementById("canvasViewport");
  const selectionBox = document.getElementById("selectionBox");
  const layersList = document.getElementById("layersList");
  const status = document.getElementById("status");
  const importMenu = document.getElementById("importMenu");

  const state = {
    version: 1,
    width: 1200,
    height: 800,
    zoom: 1,
    tool: "pen",
    color: "#111111",
    size: 6,
    layers: [],
    activeLayer: 0,
    drawing: false,
    currentStroke: null,
    pointerId: null,
    pan: {x: 0, y: 0},
    history: [],
    historyIndex: -1,
    selectedImage: null,
    transform: null
  };

  function uid(prefix="id") {
    return prefix + "_" + Date.now().toString(36) + "_" + Math.random().toString(36).slice(2,8);
  }

  function makeStrokeLayer(name="رسم") {
    return {id:uid("layer"), type:"stroke", name, visible:true, strokes:[]};
  }

  function makeImageLayer(data, name="صورة") {
    return {id:uid("layer"), type:"image", name, visible:true, image:data, x:100, y:100, w:400, h:300};
  }

  function setStatus(msg){ status.textContent = msg; }

  function currentLayer(){ return state.layers[state.activeLayer] || null; }

  function pushHistory() {
    const snapshot = JSON.stringify({
      width: state.width, height: state.height, layers: state.layers, activeLayer: state.activeLayer
    });
    state.history = state.history.slice(0, state.historyIndex + 1);
    state.history.push(snapshot);
    if (state.history.length > 50) state.history.shift();
    state.historyIndex = state.history.length - 1;
  }

  function restoreSnapshot(snapshot) {
    const s = JSON.parse(snapshot);
    state.width = s.width; state.height = s.height;
    state.layers = s.layers; state.activeLayer = Math.min(s.activeLayer, state.layers.length - 1);
    canvas.width = state.width; canvas.height = state.height;
    applyZoom();
    renderLayers();
    render();
  }

  function undo(){
    if(state.historyIndex <= 0){setStatus("لا يوجد تراجع");return}
    state.historyIndex--;
    restoreSnapshot(state.history[state.historyIndex]);
    setStatus("تم التراجع");
  }

  function redo(){
    if(state.historyIndex >= state.history.length-1){setStatus("لا توجد إعادة");return}
    state.historyIndex++;
    restoreSnapshot(state.history[state.historyIndex]);
    setStatus("تمت الإعادة");
  }

  function resetProject(){
    state.layers = [makeStrokeLayer("رسم 1")];
    state.activeLayer = 0;
    state.selectedImage = null;
    state.width = 1200; state.height = 800;
    canvas.width = state.width; canvas.height = state.height;
    state.history = []; state.historyIndex = -1;
    pushHistory();
    renderLayers(); render();
    setStatus("مشروع جديد");
  }

  function renderLayers(){
    layersList.innerHTML = "";
    [...state.layers].reverse().forEach((layer, reverseIndex) => {
      const realIndex = state.layers.length - 1 - reverseIndex;
      const row = document.createElement("div");
      row.className = "layer-row" + (realIndex === state.activeLayer ? " active" : "");
      row.innerHTML = `<span class="layer-icon">${layer.type === "image" ? "🖼" : "✎"}</span><span class="layer-name"></span>`;
      row.querySelector(".layer-name").textContent = layer.name;
      row.onclick = () => {
        state.activeLayer = realIndex;
        state.selectedImage = layer.type === "image" ? layer.id : null;
        renderLayers(); renderSelection();
      };
      layersList.appendChild(row);
    });
  }

  function addLayer(){
    state.layers.push(makeStrokeLayer(`رسم ${state.layers.length + 1}`));
    state.activeLayer = state.layers.length - 1;
    pushHistory(); renderLayers(); render(); setStatus("أضيفت طبقة");
  }

  function deleteLayer(){
    if(state.layers.length === 1){setStatus("لا يمكن حذف آخر طبقة");return}
    state.layers.splice(state.activeLayer,1);
    state.activeLayer = Math.max(0,state.activeLayer-1);
    state.selectedImage = null;
    pushHistory(); renderLayers(); render(); setStatus("حُذفت الطبقة");
  }

  function duplicateLayer(){
    const src = currentLayer(); if(!src) return;
    const copy = JSON.parse(JSON.stringify(src));
    copy.id = uid("layer"); copy.name = src.name + " نسخة";
    if(copy.type === "image"){ copy.x += 25; copy.y += 25; }
    state.layers.splice(state.activeLayer+1,0,copy);
    state.activeLayer++;
    pushHistory(); renderLayers(); render(); setStatus("نُسخت الطبقة");
  }

  function applyZoom(){
    wrap.style.width = (state.width * state.zoom) + "px";
    wrap.style.height = (state.height * state.zoom) + "px";
    canvas.style.width = (state.width * state.zoom) + "px";
    canvas.style.height = (state.height * state.zoom) + "px";
    renderSelection();
  }

  function screenToCanvas(e){
    const r = canvas.getBoundingClientRect();
    return {
      x: (e.clientX - r.left) * (state.width / r.width),
      y: (e.clientY - r.top) * (state.height / r.height)
    };
  }

  function drawSmoothStroke(c, stroke){
    if(!stroke.points.length) return;
    c.save();
    c.strokeStyle = stroke.color;
    c.lineWidth = stroke.size;
    c.lineCap = "round";
    c.lineJoin = "round";
    c.globalAlpha = stroke.opacity ?? 1;
    c.beginPath();

    const pts = stroke.points;
    if(pts.length === 1){
      c.arc(pts[0].x, pts[0].y, stroke.size/2, 0, Math.PI*2);
      c.fillStyle = stroke.color;
      c.fill();
      c.restore();
      return;
    }

    c.moveTo(pts[0].x, pts[0].y);
    for(let i=1;i<pts.length-1;i++){
      const p = pts[i], n = pts[i+1];
      const mx = (p.x+n.x)/2, my=(p.y+n.y)/2;
      c.quadraticCurveTo(p.x,p.y,mx,my);
    }
    const last=pts[pts.length-1], prev=pts[pts.length-2];
    c.quadraticCurveTo(prev.x,prev.y,last.x,last.y);
    c.stroke();
    c.restore();
  }

  function drawImageLayer(c, layer){
    if(!layer.visible || !layer.image) return;
    const img = new Image();
    img.onload = () => {
      // Render is async for images. A redraw is harmless and keeps the editor simple.
      c.save();
      c.globalAlpha = layer.opacity ?? 1;
      c.drawImage(img, layer.x, layer.y, layer.w, layer.h);
      c.restore();
    };
    img.src = layer.image;
  }

  function render(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    ctx.fillStyle = "#fff";
    ctx.fillRect(0,0,canvas.width,canvas.height);

    for(const layer of state.layers){
      if(!layer.visible) continue;
      if(layer.type === "stroke"){
        for(const stroke of layer.strokes) drawSmoothStroke(ctx, stroke);
      } else if(layer.type === "image"){
        drawImageLayer(ctx, layer);
      }
    }
    renderSelection();
  }

  function renderSelection(){
    const layer = state.layers.find(l => l.id === state.selectedImage);
    if(!layer || layer.type !== "image"){
      selectionBox.classList.add("hidden"); return;
    }
    selectionBox.classList.remove("hidden");
    selectionBox.style.left = (layer.x * state.zoom) + "px";
    selectionBox.style.top = (layer.y * state.zoom) + "px";
    selectionBox.style.width = (layer.w * state.zoom) + "px";
    selectionBox.style.height = (layer.h * state.zoom) + "px";
  }

  function distance(a,b){return Math.hypot(a.x-b.x,a.y-b.y)}

  function beginStroke(e){
    const layer = currentLayer();
    if(!layer || layer.type !== "stroke") return;
    const p = screenToCanvas(e);
    state.drawing = true; state.pointerId = e.pointerId;
    canvas.setPointerCapture(e.pointerId);
    state.currentStroke = {
      id:uid("stroke"), color:state.color, size:state.size, opacity:1, points:[p]
    };
    layer.strokes.push(state.currentStroke);
    render();
  }

  function moveStroke(e){
    if(!state.drawing || e.pointerId !== state.pointerId) return;
    const p = screenToCanvas(e);
    const pts = state.currentStroke.points;
    const last = pts[pts.length-1];

    // Filter tiny jitter. Retracing/reversing direction is deliberately allowed.
    // The stroke is rendered as a centerline with round joins/caps, avoiding the
    // self-intersecting polygon-outline problem that produced triangular spikes.
    if(distance(p,last) >= 1.2){
      pts.push(p);
      render();
    }
  }

  function endStroke(e){
    if(!state.drawing || e.pointerId !== state.pointerId) return;
    state.drawing = false;
    state.currentStroke = null;
    state.pointerId = null;
    try{canvas.releasePointerCapture(e.pointerId)}catch(_){}
    pushHistory();
    render();
    setStatus("تم الرسم");
  }

  function eraseAt(e){
    const layer=currentLayer();
    if(!layer || layer.type!=="stroke") return;
    const p=screenToCanvas(e);
    const radius=state.size*1.5;
    layer.strokes = layer.strokes.filter(s => !s.points.some(pt => distance(pt,p) <= radius));
    render();
  }

  function pickImageAt(p){
    for(let i=state.layers.length-1;i>=0;i--){
      const l=state.layers[i];
      if(l.type==="image" && l.visible && p.x>=l.x && p.x<=l.x+l.w && p.y>=l.y && p.y<=l.y+l.h) return l;
    }
    return null;
  }

  function moveSelectedImage(e){
    const layer=state.layers.find(l=>l.id===state.selectedImage);
    if(!layer) return;
    const p=screenToCanvas(e);
    if(!state.transform){
      state.transform={start:p,x:layer.x,y:layer.y,w:layer.w,h:layer.h};
    }
    layer.x=state.transform.x+(p.x-state.transform.start.x);
    layer.y=state.transform.y+(p.y-state.transform.start.y);
    render(); renderSelection();
  }

  let draggingImage=false;
  canvas.addEventListener("pointerdown", e=>{
    if(state.tool==="pen"){ beginStroke(e); return; }
    if(state.tool==="eraser"){ eraseAt(e); return; }
    if(state.tool==="select"){
      const p=screenToCanvas(e), hit=pickImageAt(p);
      if(hit){
        state.selectedImage=hit.id;
        state.activeLayer=state.layers.indexOf(hit);
        draggingImage=true;
        state.transform={start:p,x:hit.x,y:hit.y,w:hit.w,h:hit.h};
        renderLayers(); renderSelection();
        canvas.setPointerCapture(e.pointerId);
      } else {
        state.selectedImage=null; renderSelection();
      }
    }
  });

  canvas.addEventListener("pointermove", e=>{
    if(state.tool==="pen"){moveStroke(e);return}
    if(state.tool==="eraser" && (e.buttons&1)){eraseAt(e);return}
    if(state.tool==="select" && draggingImage){moveSelectedImage(e)}
  });

  canvas.addEventListener("pointerup", e=>{
    if(state.tool==="pen") endStroke(e);
    if(state.tool==="select" && draggingImage){
      draggingImage=false; state.transform=null;
      pushHistory(); setStatus("تم تحريك الصورة");
      try{canvas.releasePointerCapture(e.pointerId)}catch(_){}
    }
  });

  canvas.addEventListener("pointercancel", e=>{
    if(state.tool==="pen") endStroke(e);
    draggingImage=false; state.transform=null;
  });

  document.querySelectorAll(".tool").forEach(btn=>{
    btn.addEventListener("click",()=>{
      document.querySelectorAll(".tool").forEach(b=>b.classList.remove("active"));
      btn.classList.add("active");
      state.tool=btn.dataset.tool;
      if(state.tool!=="select") state.selectedImage=null;
      renderSelection();
      setStatus(btn.title);
    });
  });

  document.getElementById("colorInput").addEventListener("input",e=>state.color=e.target.value);
  document.getElementById("sizeInput").addEventListener("input",e=>{
    state.size=+e.target.value; document.getElementById("sizeValue").value=state.size;
  });
  document.getElementById("zoomInput").addEventListener("input",e=>{
    state.zoom=+e.target.value/100;
    document.getElementById("zoomValue").value=e.target.value+"%";
    applyZoom();
  });

  document.getElementById("undoBtn").onclick=undo;
  document.getElementById("redoBtn").onclick=redo;
  document.getElementById("newBtn").onclick=()=>{if(confirm("بدء مشروع جديد؟")) resetProject()};
  document.getElementById("addLayerBtn").onclick=addLayer;
  document.getElementById("deleteLayerBtn").onclick=deleteLayer;
  document.getElementById("duplicateLayerBtn").onclick=duplicateLayer;

  document.getElementById("menuBtn").onclick=e=>{
    e.stopPropagation(); importMenu.classList.toggle("hidden");
  };
  document.addEventListener("click",e=>{
    if(!importMenu.contains(e.target) && e.target.id!=="menuBtn") importMenu.classList.add("hidden");
  });

  importMenu.addEventListener("click",e=>{
    const btn=e.target.closest("button[data-import]"); if(!btn)return;
    importMenu.classList.add("hidden");
    if(btn.dataset.import==="image") document.getElementById("imageInput").click();
    else if(btn.dataset.import==="project") document.getElementById("projectInput").click();
    else setStatus("هذا النوع سيضاف في المرحلة التالية");
  });

  document.getElementById("imageInput").addEventListener("change",e=>{
    const file=e.target.files[0]; if(!file)return;
    const reader=new FileReader();
    reader.onload=()=>{
      const img=new Image();
      img.onload=()=>{
        const maxW=500, maxH=400, scale=Math.min(1,maxW/img.width,maxH/img.height);
        const layer=makeImageLayer(reader.result,file.name);
        layer.w=Math.max(1,img.width*scale);
        layer.h=Math.max(1,img.height*scale);
        layer.x=(state.width-layer.w)/2; layer.y=(state.height-layer.h)/2;
        state.layers.push(layer);
        state.activeLayer=state.layers.length-1;
        state.selectedImage=layer.id;
        pushHistory(); renderLayers(); render(); setStatus("تم إدراج الصورة");
      };
      img.src=reader.result;
    };
    reader.readAsDataURL(file);
    e.target.value="";
  });

  function downloadBlob(blob,name){
    const a=document.createElement("a");
    a.href=URL.createObjectURL(blob); a.download=name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(a.href),1000);
  }

  document.getElementById("saveBtn").onclick=()=>{
    const data={
      format:"vpaint", version:state.version, width:state.width,height:state.height,
      layers:state.layers, activeLayer:state.activeLayer
    };
    downloadBlob(new Blob([JSON.stringify(data)],{type:"application/json"}),"reesha-project.vpaint");
    setStatus("تم حفظ المشروع");
  };

  document.getElementById("openBtn").onclick=()=>document.getElementById("projectInput").click();

  document.getElementById("projectInput").addEventListener("change",e=>{
    const file=e.target.files[0];if(!file)return;
    const reader=new FileReader();
    reader.onload=()=>{
      try{
        const d=JSON.parse(reader.result);
        if(d.format!=="vpaint" || !Array.isArray(d.layers)) throw new Error("ملف غير صالح");
        state.width=d.width||1200;state.height=d.height||800;
        state.layers=d.layers;state.activeLayer=Math.max(0,Math.min(d.activeLayer||0,state.layers.length-1));
        state.selectedImage=null;
        canvas.width=state.width;canvas.height=state.height;
        state.history=[];state.historyIndex=-1;pushHistory();
        renderLayers();render();setStatus("تم فتح المشروع");
      }catch(err){alert("تعذر فتح المشروع: "+err.message)}
    };
    reader.readAsText(file);e.target.value="";
  });

  document.getElementById("exportPngBtn").onclick=()=>{
    // Canvas already contains the current composition.
    canvas.toBlob(blob=>downloadBlob(blob,"reesha.png"),"image/png");
    setStatus("تم تصدير PNG");
  };

  function svgEscape(s){return String(s).replace(/&/g,"&amp;").replace(/"/g,"&quot;").replace(/</g,"&lt;").replace(/>/g,"&gt;")}
  function pointsToPath(points){
    if(!points.length)return "";
    if(points.length===1)return `M ${points[0].x} ${points[0].y}`;
    let d=`M ${points[0].x} ${points[0].y}`;
    for(let i=1;i<points.length-1;i++){
      const p=points[i],n=points[i+1];
      d+=` Q ${p.x} ${p.y} ${(p.x+n.x)/2} ${(p.y+n.y)/2}`;
    }
    const p=points[points.length-2],n=points[points.length-1];
    d+=` Q ${p.x} ${p.y} ${n.x} ${n.y}`;
    return d;
  }

  document.getElementById("exportSvgBtn").onclick=()=>{
    const parts=[`<svg xmlns="http://www.w3.org/2000/svg" width="${state.width}" height="${state.height}" viewBox="0 0 ${state.width} ${state.height}">`,
      `<rect width="100%" height="100%" fill="white"/>`];
    for(const layer of state.layers){
      if(!layer.visible)continue;
      if(layer.type==="stroke"){
        for(const s of layer.strokes){
          if(!s.points.length)continue;
          if(s.points.length===1){
            parts.push(`<circle cx="${s.points[0].x}" cy="${s.points[0].y}" r="${s.size/2}" fill="${svgEscape(s.color)}"/>`);
          }else{
            parts.push(`<path d="${pointsToPath(s.points)}" fill="none" stroke="${svgEscape(s.color)}" stroke-width="${s.size}" stroke-linecap="round" stroke-linejoin="round"/>`);
          }
        }
      }else if(layer.type==="image" && layer.image){
        parts.push(`<image href="${layer.image}" x="${layer.x}" y="${layer.y}" width="${layer.w}" height="${layer.h}" preserveAspectRatio="none"/>`);
      }
    }
    parts.push("</svg>");
    downloadBlob(new Blob([parts.join("")],{type:"image/svg+xml"}),"reesha.svg");
    setStatus("تم تصدير SVG");
  };

  resetProject();
})();
